    "exams": [
        {
            "id": 1,
            "name": "Eletrocardiograma",
            "description": "Exame de rápida execução que analisa a atividade elétrica do coração."
        },
        {
            "id": 2,
            "name": "EcoDopplercardiograma",
            "description": "Exame ultrassonográfico onde pode-se analisar estrutura e funcionamento do coração."
        },
        {
            "id": 3,
            "name": "Ultrassom Doppler de carótidas e vertebrais",
            "description": "Exame ultrassonográfico onde pode-se analisar estrutura das artérias carótidas e vertebrais assim como presença de ateromatose."
        },
        {
            "id": 4,
            "name": "Mapa 24h",
            "description": "Monitorização da pressão arterial, com medidas de 20 em 20 minutos durante a vigília e de 30 em 30 minutos durante o sono, por um período de 24h."
        },
        {
            "id": 5,
            "name": "Holter de 24h",
            "description": "Monitorização da atividade elétrica do coração por um período de 24h."
        },
        {
            "id": 6,
            "name": "Teste Ergométrico",
            "description": "Teste de esforço físico em esteira ergométrica com objetivo de avaliar sinais de isquemia miocárdica e aptidão cardiorrespiratória."
        },
        {
            "id": 7,
            "name": "Polissonografia (Tipo 3)",
            "description": "Exame do sono simplificado realizado em casa, usado principalmente para investigar apneia obstrutiva do sono com conforto."
        }
    ]
